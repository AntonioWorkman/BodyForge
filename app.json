{
  "expo": {
    "name": "BodyForge",
    "slug": "bodyforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bodyforge",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08060D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gravatum.bodyforge",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.gravatum.bodyforge",
      "adaptiveIcon": {
        "backgroundColor": "#08060D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "BodyForge uses your photo library only to set a local player avatar. The image never leaves your device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#08060D",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5aadfa1f-0cd0-4808-b823-484e1bdb9fb2"
      }
    }
  }
}
